---
import '~/css/main.css';

import { Font } from 'astro:assets';
import Footer from '~/components/site/footer.astro';
import Header from '~/components/site/header.astro';
import Seo, { type Props as SeoProps } from '~/components/site/seo.astro';

export interface Props extends SeoProps {}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<link rel="icon" href="data:," />

		<Seo {...Astro.props} />

		<Font cssVariable="--font-family-serif" preload />

		<!-- Indieauth -->
		<link rel="authorization_endpoint" href="https://indieauth.com/auth" />
		<link rel="token_endpoint" href="https://tokens.indieauth.com/token" />

		<!-- IndieAuth rel-me links -->
		<link href="mailto:binyamingreen@protonmail.com" rel="me" />
		<link href="https://github.com/binyamin" rel="me" />

		<slot name="head" />
	</head>
	<body class="cover flow">
		<Header />
		<main class="cover_target">
			<slot />
		</main>
		<Footer />
	</body>
</html>
