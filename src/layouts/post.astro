---
import { type CollectionEntry, render } from 'astro:content';
import Layout from '~/layouts/base.astro';
import { dateEst } from '~/lib/utils';

interface Props {
	post: CollectionEntry<'blog' | 'micro'>;
}
const data = Astro.props.post.data;
const { Content } = await render(Astro.props.post);
---

<Layout
	title={data.title}
	description={data.description}
	thumbnail={data.thumbnail?.src}
	type="post"
>
	<article>
		<h1>{data.title}</h1>
		<p>
			Published on
			<a href={Astro.url}>
				<time datetime={data.date.toISOString().split('T')[0]}>
					{dateEst(data.date, undefined, false)}
				</time>
			</a>
		</p>

		<div>
			<Content />
		</div>

		<a href="#top" class="sr-only">Top</a>
	</article>
</Layout>
