---
import { dateEst } from '~/lib/utils';

export interface Props {
	url: string;
	title: string;
	date: Date;
}

const { props } = Astro;
---

<div class="h-entry">
	<time
		class="dt-published"
		datetime={props.date.toISOString().split('T')[0]}
	>{dateEst(props.date, undefined, false)}</time>

	<a href={props.url} class="u-url u-uid p-name">{props.title}</a>
</div>
