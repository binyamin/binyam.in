---
import { dateEst } from '~/lib/utils';

export interface Props {
	url: string;
	title: string;
	date: Date;
}

const { props } = Astro;
---

<div>
	<time
		datetime={props.date.toISOString().split('T')[0]}
	>{dateEst(props.date, undefined, false)}</time>

	<a href={props.url}>{props.title}</a>
</div>
