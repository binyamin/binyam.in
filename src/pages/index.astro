---
import IconArrow from '~/assets/icons/arrow-right.svg';
import Layout from '~/layouts/base.astro';
import * as cfg from '~/site.config';
---

<style>
	h1 {
		font-size: var(--font-size-4xl);
	}

	a {
		display: flex;
		gap: var(--space-3xs);
	}
</style>

<Layout title="" type="page">
	<div class="prose flow">
		<h1>{cfg.me.firstName}</h1>
		<p>Many people build websites. I build websites for people.</p>
		<p>
			I focus on the pieces some developers forget: well-structured code,
			cohesive design, and the end-user. If you've landed here, you probably
			care about them too.
		</p>
		<!-- <a href="/projects"><IconArrow />See my work</a> -->
		<a href="/contact"><IconArrow />My inbox is open 24/6</a>
	</div>
</Layout>
